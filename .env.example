# Copy this file to .env (gitignored) and fill in your real values.
# docker compose reads .env automatically.

GMAIL_TO=your_email@example.com

# JSearch (RapidAPI) — the job source. Free tier is ~200 requests/month.
# Sign up, subscribe to the free "Basic" plan, and copy your key:
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Optional: point the agent at an existing Google Sheet instead of letting it
# create "Second Brain — Internships" in your Drive on first run.
# SHEET_ID=
